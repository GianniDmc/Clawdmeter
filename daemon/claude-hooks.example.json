{
  "_comment": "Merge into ~/.claude/settings.json (replace <repo> with the absolute checkout path) so Clawd mirrors Claude Code: working, waiting for you, done. The daemon forwards the state as the cc field.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<repo>/daemon/.venv/bin/python <repo>/daemon/claude_state_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "<repo>/daemon/.venv/bin/python <repo>/daemon/claude_state_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "<repo>/daemon/.venv/bin/python <repo>/daemon/claude_state_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "<repo>/daemon/.venv/bin/python <repo>/daemon/claude_state_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "<repo>/daemon/.venv/bin/python <repo>/daemon/claude_state_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<repo>/daemon/.venv/bin/python <repo>/daemon/claude_state_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<repo>/daemon/.venv/bin/python <repo>/daemon/claude_state_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<repo>/daemon/.venv/bin/python <repo>/daemon/claude_state_hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
