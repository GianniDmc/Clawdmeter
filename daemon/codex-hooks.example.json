{
  "_comment": "Merge into ~/.codex/hooks.json (replace <repo> with the absolute checkout path) so the device's Codex page mirrors Codex: working, approval needed, done.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<repo>/daemon/.venv/bin/python <repo>/daemon/claude_state_hook.py codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<repo>/daemon/.venv/bin/python <repo>/daemon/claude_state_hook.py codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<repo>/daemon/.venv/bin/python <repo>/daemon/claude_state_hook.py codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<repo>/daemon/.venv/bin/python <repo>/daemon/claude_state_hook.py codex",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<repo>/daemon/.venv/bin/python <repo>/daemon/claude_state_hook.py codex",
            "timeout": 5
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<repo>/daemon/.venv/bin/python <repo>/daemon/claude_state_hook.py codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<repo>/daemon/.venv/bin/python <repo>/daemon/claude_state_hook.py codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<repo>/daemon/.venv/bin/python <repo>/daemon/claude_state_hook.py codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
